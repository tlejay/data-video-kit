# Copy to .env (git-ignored) and fill in. Never commit .env.
# Only the voice step needs keys; everything else in the kit is free and local.

# One ElevenLabs key...
ELEVENLABS_API_KEY=
# ...or a pool, comma-separated (the scripts pick the key that has room for each clip)
ELEVENLABS_API_KEYS=

# Any voice from your ElevenLabs Voice Library (Voices > ... > Copy voice ID)
ELEVENLABS_VOICE_ID=
# eleven_v4 (default) or eleven_v3; both support [audio tags]
ELEVENLABS_MODEL_ID=eleven_v4

# Voice settings (the expressive defaults this kit was tuned on)
TTS_STABILITY=0.25
TTS_SIMILARITY=0.75
TTS_STYLE=0.75

# Optional backup voice when every ElevenLabs key is out
PAXALABS_API_KEY=
PAXALABS_VOICE=tako
# TTS_BACKEND=paxa   # force the backup for a test

# Optional locations (defaults: .tts/cache and .tts/ledger.jsonl in this folder)
# TTS_CACHE_DIR=
# TTS_LEDGER=

# Written by /kiki-init: your defaults for new videos
# DVK_TEMPLATE=line-cartoon
# DVK_MUSIC_MOOD=bright
